<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Tema base da janela; as cores reais da interface vêm do Material 3 no Compose. -->
    <style name="Theme.ControleGastos" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/fundo_marca</item>
    </style>

    <!-- Tela de abertura (Android 12+ nativo; versões anteriores via core-splashscreen). -->
    <style name="Theme.ControleGastos.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/fundo_marca</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="postSplashScreenTheme">@style/Theme.ControleGastos</item>
    </style>
</resources>
