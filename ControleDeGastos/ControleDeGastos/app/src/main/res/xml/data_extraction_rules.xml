<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: inclui banco de dados, anexos e preferências no backup do Google e na transferência entre aparelhos. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="." />
        <include domain="file" path="anexos/" />
        <include domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
        <include domain="file" path="anexos/" />
        <include domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
